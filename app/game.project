[bootstrap]
main_collection = /main/main.collectionc
render = /default.renderc

[script]
shared_state = 1

[display]
width = 1280
height = 720
update_frequency = 60

[android]
input_method = HiddenInputField

[project]
title = astral-supp
dependencies#0 = https://github.com/ts-defold/defold-lldebugger/archive/extension.zip
dependencies#1 = https://github.com/Insality/defold-tweener/archive/refs/tags/5.zip
dependencies#2 = https://github.com/Insality/panthera/archive/refs/tags/runtime.6.zip

[render]
clear_color_red = 0.19
clear_color_green = 0.47
clear_color_blue = 0.78

[input]
game_binding = /game.input_bindingc

[physics]
debug = 0

