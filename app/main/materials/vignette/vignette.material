name: "vignette"
tags: "tile"
vertex_program: "/main/materials/vignette/vignette.vp"
fragment_program: "/main/materials/vignette/vignette.fp"
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
fragment_constants {
  name: "tint"
  type: CONSTANT_TYPE_USER
  value {
    w: 0.1
  }
}
fragment_constants {
  name: "intensity"
  type: CONSTANT_TYPE_USER
  value {
    x: 150.0
  }
}
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_DEFAULT
  filter_mag: FILTER_MODE_MAG_DEFAULT
  max_anisotropy: 0.0
}
